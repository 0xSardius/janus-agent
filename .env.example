# ═══════════════════════════════════════════════════════════════════════════
# WALLET — Choose ONE mode:
#   Option A: Local private key (recommended — no API deps, no rate limits)
#   Option B: CDP Server Wallet (requires Coinbase API keys)
# ═══════════════════════════════════════════════════════════════════════════

# Option A: Local wallet (recommended)
# Generate with: node -e "console.log(require('viem/accounts').generatePrivateKey())"
WALLET_PRIVATE_KEY=0x...

# Option B: CDP wallet (from https://portal.cdp.coinbase.com)
# CDP_API_KEY_NAME=your-api-key-name
# CDP_API_KEY_PRIVATE=your-api-key-private
# CDP_WALLET_DATA=

# ═══════════════════════════════════════════════════════════════════════════
# RPC ENDPOINTS
# ═══════════════════════════════════════════════════════════════════════════
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# Or use public RPC for testing: https://mainnet.base.org

# ═══════════════════════════════════════════════════════════════════════════
# FLAUNCH SUBGRAPH
# ═══════════════════════════════════════════════════════════════════════════
FLAUNCH_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_.../subgraphs/flaunch-base/1.0.0/gn

# ═══════════════════════════════════════════════════════════════════════════
# AI / LLM (Anthropic Claude)
# ═══════════════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...

# ═══════════════════════════════════════════════════════════════════════════
# IMAGE GENERATION (Fal.ai)
# Get your key at https://fal.ai/dashboard/keys
# ═══════════════════════════════════════════════════════════════════════════
FAL_KEY=...

# ═══════════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Enable LLM-enhanced concept scoring (uses Anthropic API, costs more)
ENABLE_LLM_SCORING=false
# Max concepts to analyze with LLM per cycle (default: 5)
LLM_ANALYSIS_LIMIT=5

# ═══════════════════════════════════════════════════════════════════════════
# ALERTS (Discord + Slack)
# ═══════════════════════════════════════════════════════════════════════════
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════════════
# ERC-8004 ON-CHAIN IDENTITY
# ═══════════════════════════════════════════════════════════════════════════
# Enable agent identity registration at startup
ENABLE_IDENTITY_REGISTRATION=false
# Agent URI for ERC-8004 registration (JSON metadata URL)
AGENT_URI=
# Override the default Base identity registry address
BASE_IDENTITY_REGISTRY=
# Set after first registration to skip re-registering
ERC8004_AGENT_ID=

# ═══════════════════════════════════════════════════════════════════════════
# SOCIAL SIGNALS (Phase 4)
# ═══════════════════════════════════════════════════════════════════════════
# Neynar API key for Farcaster signals (https://neynar.com)
NEYNAR_API_KEY=
# Twitter/X API v2 Bearer Token
TWITTER_BEARER_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# PERFORMANCE AUTO-TUNER (Phase 4)
# ═══════════════════════════════════════════════════════════════════════════
# Enable auto-tuning of scoring weights based on performance
ENABLE_AUTO_TUNER=false

# ═══════════════════════════════════════════════════════════════════════════
# API GATING (Phase 4)
# ═══════════════════════════════════════════════════════════════════════════
# Enable x402 payment gating for /api/* endpoints
ENABLE_API_GATING=false

# ═══════════════════════════════════════════════════════════════════════════
# PERSISTENCE (Phase 5)
# ═══════════════════════════════════════════════════════════════════════════
# SQLite database file path (default: ./janus.db)
SQLITE_DB_PATH=./janus.db
